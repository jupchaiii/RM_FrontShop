# Database
DATABASE_URL="file:./data.db"

# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d

# Admin (used by seed)
ADMIN_EMAIL=admin@remaker.work
ADMIN_PASSWORD=admin1234

# File upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
